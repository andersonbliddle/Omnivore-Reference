{
  "name": "drawing-reference-app",
  "version": "1.0.0",
  "description": "A timed drawing reference app for artists",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "drawing",
    "reference",
    "timer",
    "art"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.32.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  },
  "build": {
    "appId": "com.yourname.drawing-reference",
    "productName": "Drawing Reference",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "styles.css"
    ]
  }
}
